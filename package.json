{
  "name": "offertest",
  "version": "0.1.0",
  "description": "An AI agent that follows your Meta ad's funnel like a customer and checks that the offer holds, before the ad spends.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "offertest": "./dist/cli.mjs" },
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" }
  },
  "files": ["dist", "skills", "README.md", "LICENSE"],
  "engines": { "node": ">=22.12.0" },
  "keywords": ["meta", "ads", "agent", "computer-use", "playwright", "muse", "funnel", "testing"],
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 test/*.e2e.ts",
    "test:journeys": "node --import tsx --test --test-concurrency=1 test/journeys/*.e2e.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "openai": "^7.45.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsdown": "^0.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
