{
  "name": "offertest-demo-store",
  "version": "0.1.0",
  "private": true,
  "description": "Alder Trail Co.: a small store with switchable offer bugs, used for the OfferTest eval and demo.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "css": "node src/app/store/_styles/build-css.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:db:local": "wrangler d1 migrations apply STORE_DB --local",
    "cf:db:remote": "wrangler d1 migrations apply STORE_DB --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4",
    "@tailwindcss/oxide": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  }
}
