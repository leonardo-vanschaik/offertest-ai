# OfferTest keys. Copy this file to .env (never committed) and fill in the values,
# or run `npx offertest init` for a guided setup. Then check with `npx offertest doctor`.

# 1. Meta Model API key (required). Get it at https://dev.meta.ai (API keys).
META_API_KEY=

# 2. Ads Manager token (optional: test ads by id or by account, pause failing ads).
#    Graph API Explorer: https://developers.facebook.com/tools/explorer
#    Permissions: ads_read, ads_management, pages_show_list, pages_read_engagement, pages_manage_ads
#    Step-by-step guide: docs/SETUP.md
META_ACCESS_TOKEN=

# 3. Default ad account (optional), for example act_1234567890. `npx offertest init` lists yours.
META_AD_ACCOUNT_ID=

# Optional: your store's ACP agent checkout, and a Stripe test key for ACP test payments.
# OFFERTEST_ACP_URL=
# OFFERTEST_ACP_KEY=
# STRIPE_TEST_KEY=sk_test_...

# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# OFFERTEST_WONDER_MODEL=muse-wonder-1.0
# OFFERTEST_SPARK_MODEL=muse-spark-1.3
