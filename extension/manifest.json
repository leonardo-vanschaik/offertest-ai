{
  "manifest_version": 3,
  "name": "OfferTest for Ads Manager",
  "version": "0.1.0",
  "description": "Test the offer before the ad spends: an AI agent follows your Meta ad's funnel like a customer and checks every promise.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OfferTest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://adsmanager.facebook.com/*",
    "https://business.facebook.com/*",
    "http://127.0.0.1:7777/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://adsmanager.facebook.com/*", "https://business.facebook.com/adsmanager/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
